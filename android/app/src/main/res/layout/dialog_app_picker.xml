<?xml version="1.0" encoding="utf-8"?>
<!-- 「允许操作的应用」选择器：上面搜、下面勾。装了几百个应用的手机上，光靠翻列表找微信太难。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/picker_search_box"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/row_control_apps_search"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/picker_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 列表区高度由代码给（屏幕六成、最多 420dp）：弹窗把 setView 传进来的那一层强行
         撑成 MATCH_PARENT，所以高度得挂在这一层上，挂在根上会被冲掉。 -->
    <FrameLayout
        android:id="@+id/picker_list_box"
        android:layout_width="match_parent"
        android:layout_height="320dp">

        <android.widget.ListView
            android:id="@+id/picker_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="?attr/colorOutlineVariant"
            android:dividerHeight="1px"
            android:scrollbarStyle="outsideOverlay" />

        <!-- 搜不到的时候总得说一句，别让人以为列表坏了 -->
        <TextView
            android:id="@+id/picker_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/row_control_apps_empty"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
