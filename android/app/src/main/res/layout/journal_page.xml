<?xml version="1.0" encoding="utf-8"?>
<!-- 任务日志回放：从设置里点进来，一屏一步，新在上；顶上一排是复制/清空/关闭。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/journal_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/journal_title"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/journal_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/journal_copy"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/journal_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/journal_clear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/journal_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/journal_close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/journal_close" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/journal_filter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingBottom="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/journal_chip_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/journal_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/journal_chip_failed"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/journal_filter_failed" />

            <com.google.android.material.chip.Chip
                android:id="@+id/journal_chip_latest"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/journal_filter_latest" />
        </com.google.android.material.chip.ChipGroup>

        <!-- 日志在手机上翻不完，导成文件发给别处看 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/journal_export"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/journal_export" />
    </LinearLayout>

    <!-- 「只看某个应用」是叠加在三个 chip 之外的第二个维度，所以单独一行：
         它和「只看失败」能同时生效，点 chip 或它后面的 ✕ 就取消。 -->
    <LinearLayout
        android:id="@+id/journal_app_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <com.google.android.material.chip.Chip
            android:id="@+id/journal_chip_app"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:closeIcon="@drawable/ic_close"
            app:closeIconVisible="true" />
    </LinearLayout>

    <!-- 「只看某个动作」：日志里出现过哪些动作（点按 / 输入文字 / 截图）就给哪几颗 chip，
         点一下只剩这一类，再点一下取消。它和应用筛选一样是叠在「只看失败 / 最近一轮」之外的维度。 -->
    <HorizontalScrollView
        android:id="@+id/journal_action_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/journal_action_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true" />
    </HorizontalScrollView>

    <!-- 搜一个词：步骤里的字、应用名、错误码都能搜到；和上面几维筛选叠着用。 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/journal_search_box"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:hint="@string/journal_search_hint"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/journal_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <ScrollView
        android:id="@+id/journal_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/journal_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp" />
    </ScrollView>
</LinearLayout>
