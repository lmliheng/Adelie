<?xml version="1.0" encoding="utf-8"?>
<!-- 操作中显示在屏幕顶部的胶囊：左边是正在操作的应用，中间是这一步在做什么，右边暂停/停止 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ov_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/ov_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/ov_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ov_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="196dp"
            android:maxLines="1"
            android:textColor="@color/control_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ov_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="196dp"
            android:maxLines="1"
            android:textColor="@color/control_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ov_pause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/ov_button"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="@string/control_pause"
        android:textColor="@color/control_text"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/ov_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/ov_button_danger"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="@string/control_stop"
        android:textColor="@color/control_text"
        android:textSize="11sp" />
</LinearLayout>
