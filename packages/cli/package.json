{
  "name": "@adelie/cli",
  "version": "0.5.9",
  "type": "module",
  "description": "Adelie CLI: interactive REPL and single-task runner over @adelie/core.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmliheng/Adelie.git",
    "directory": "packages/cli"
  },
  "bin": {
    "penguin": "./dist/penguin.js",
    "penguin-hmr": "./dist/penguin-hmr.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup",
    "penguin": "node ../../scripts/run-with-env.mjs ADELIE_HOME=~/.penguin/dev-data-cli ADELIE_PROFILE=dev PORT=7370 -- tsx src/penguin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@adelie/agent-company": "workspace:*",
    "@adelie/agent-development": "workspace:*",
    "@adelie/agent-tuning": "workspace:*",
    "@adelie/browser-automation": "workspace:*",
    "@adelie/continual-learning": "workspace:*",
    "@adelie/csu-mail": "workspace:*",
    "@adelie/data-analysis": "workspace:*",
    "@adelie/goal": "workspace:*",
    "@adelie/humanizer": "workspace:*",
    "@adelie/lesson-video": "workspace:*",
    "@adelie/model-development": "workspace:*",
    "@adelie/requirements-box": "workspace:*",
    "@adelie/skill-porting": "workspace:*",
    "@adelie/software-development": "workspace:*",
    "@adelie/use-bento-slides": "workspace:*",
    "@adelie/use-firecrawl": "workspace:*",
    "@adelie/use-lieflat-charts": "workspace:*",
    "@adelie/use-offerdao": "workspace:*",
    "@adelie/use-seedance": "workspace:*",
    "@adelie/use-wps-office": "workspace:*",
    "@adelie/use-claude-code": "workspace:*",
    "@adelie/wechat-miniprogram": "workspace:*",
    "@prismshadow/agenthub": "^0.4.15",
    "@adelie/core": "workspace:*",
    "@adelie/server": "workspace:*",
    "commander": "^13.0.0",
    "dotenv": "^17.0.0",
    "smol-toml": "^1.3.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
