{
  "name": "@adelie/core",
  "version": "0.5.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Adelie core SDK: context_engine, OmniMessage protocol, LLM/Environment interfaces.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmliheng/Adelie.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./omnimessage": {
      "types": "./dist/omnimessage/index.d.ts",
      "import": "./dist/omnimessage/index.js"
    },
    "./markers": {
      "types": "./dist/omnimessage/markers/index.d.ts",
      "import": "./dist/omnimessage/markers/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./context-limits": {
      "types": "./dist/llm/context-limits.d.ts",
      "import": "./dist/llm/context-limits.js"
    },
    "./model-catalog": {
      "types": "./dist/state/model-catalog.d.ts",
      "import": "./dist/state/model-catalog.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js",
      "default": "./dist/kernel/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "node ../../scripts/run-with-env.mjs ADELIE_E2E=1 -- vitest run test/llm.e2e.test.ts",
    "build": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@adelie/agent-company": "workspace:*",
    "@adelie/agent-development": "workspace:*",
    "@adelie/agent-tuning": "workspace:*",
    "@adelie/browser-automation": "workspace:*",
    "@adelie/continual-learning": "workspace:*",
    "@adelie/csu-mail": "workspace:*",
    "@adelie/data-analysis": "workspace:*",
    "@adelie/goal": "workspace:*",
    "@adelie/humanizer": "workspace:*",
    "@adelie/lesson-video": "workspace:*",
    "@adelie/model-development": "workspace:*",
    "@adelie/requirements-box": "workspace:*",
    "@adelie/skill-porting": "workspace:*",
    "@adelie/software-development": "workspace:*",
    "@adelie/use-bento-slides": "workspace:*",
    "@adelie/use-firecrawl": "workspace:*",
    "@adelie/use-offerdao": "workspace:*",
    "@adelie/use-wps-office": "workspace:*",
    "@adelie/use-claude-code": "workspace:*",
    "@adelie/wechat-miniprogram": "workspace:*",
    "@prismshadow/agenthub": "^0.4.15",
    "arktype": "^2.2.3",
    "smol-toml": "^1.3.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6",
    "zod": "^4.2.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
