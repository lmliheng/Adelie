{
  "name": "@lmliheng/penguin-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Adelie desktop app: Electron shell running @lmliheng/penguin-server as a utilityProcess, window on http://localhost (same-origin HTTP/SSE, no private IPC).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup && node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start": "node scripts/preflight.mjs && electron .",
    "pack": "node scripts/preflight.mjs && electron-builder",
    "pack:linux": "node scripts/preflight.mjs && electron-builder --linux",
    "pack:mac": "node scripts/preflight.mjs && electron-builder --mac",
    "pack:win": "node scripts/preflight.mjs && electron-builder --win"
  },
  "dependencies": {
    "@lmliheng/agent-company": "workspace:*",
    "@lmliheng/agent-development": "workspace:*",
    "@lmliheng/agent-tuning": "workspace:*",
    "@lmliheng/browser-automation": "workspace:*",
    "@lmliheng/continual-learning": "workspace:*",
    "@lmliheng/csu-mail": "workspace:*",
    "@lmliheng/data-analysis": "workspace:*",
    "@lmliheng/goal": "workspace:*",
    "@lmliheng/humanizer": "workspace:*",
    "@lmliheng/model-development": "workspace:*",
    "@lmliheng/skill-porting": "workspace:*",
    "@lmliheng/software-development": "workspace:*",
    "@lmliheng/use-bento-slides": "workspace:*",
    "@lmliheng/use-firecrawl": "workspace:*",
    "@lmliheng/use-claude-code": "workspace:*",
    "@lmliheng/wechat-miniprogram": "workspace:*"
  },
  "devDependencies": {
    "@lmliheng/penguin-cli": "workspace:*",
    "@lmliheng/penguin-core": "workspace:*",
    "@lmliheng/penguin-server": "workspace:*",
    "@types/node": "^24.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.16.1",
    "electron-updater": "^6.8.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
