{
  "name": "adelie-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adelie 桌面壳（Windows）：Electron 启动内置服务端，窗口加载 http://127.0.0.1:<port>。",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup",
    "start": "electron .",
    "pack:win": "electron-builder --win --config electron-builder.yml",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "adelie-server": "workspace:*",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
