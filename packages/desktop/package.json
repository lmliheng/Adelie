{
  "name": "@adelie/desktop",
  "version": "0.5.10",
  "private": true,
  "type": "module",
  "description": "Adelie desktop app: Electron shell running @adelie/server as a utilityProcess, window on http://localhost (same-origin HTTP/SSE, no private IPC).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup && node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start": "node scripts/preflight.mjs && electron .",
    "pack": "node scripts/preflight.mjs && electron-builder",
    "pack:linux": "node scripts/preflight.mjs && electron-builder --linux",
    "pack:mac": "node scripts/preflight.mjs && electron-builder --mac",
    "pack:win": "node scripts/preflight.mjs && electron-builder --win"
  },
  "dependencies": {
    "@adelie/agent-company": "workspace:*",
    "@adelie/agent-development": "workspace:*",
    "@adelie/agent-tuning": "workspace:*",
    "@adelie/browser-automation": "workspace:*",
    "@adelie/continual-learning": "workspace:*",
    "@adelie/csu-mail": "workspace:*",
    "@adelie/data-analysis": "workspace:*",
    "@adelie/goal": "workspace:*",
    "@adelie/humanizer": "workspace:*",
    "@adelie/lesson-video": "workspace:*",
    "@adelie/model-development": "workspace:*",
    "@adelie/requirements-box": "workspace:*",
    "@adelie/skill-porting": "workspace:*",
    "@adelie/software-development": "workspace:*",
    "@adelie/use-bento-slides": "workspace:*",
    "@adelie/use-firecrawl": "workspace:*",
    "@adelie/use-lieflat-charts": "workspace:*",
    "@adelie/use-offerdao": "workspace:*",
    "@adelie/use-seedance": "workspace:*",
    "@adelie/use-seedream": "workspace:*",
    "@adelie/use-wps-office": "workspace:*",
    "@adelie/use-claude-code": "workspace:*",
    "@adelie/wechat-miniprogram": "workspace:*"
  },
  "devDependencies": {
    "@adelie/cli": "workspace:*",
    "@adelie/core": "workspace:*",
    "@adelie/server": "workspace:*",
    "@types/node": "^24.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.16.1",
    "electron-updater": "^6.8.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
